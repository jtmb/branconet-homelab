# Encryption Key (generate a new one with: openssl rand -hex 32)
ENCRYPTION_KEY=2f8a9b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a

# Database URL (SQLite)
DATABASE_URL="file:./dev.db"

# Next.js server port
PORT=3000

# Ansible playbook path (relative to project root)
ANSIBLE_PLAYBOOK_PATH=./k8s-rewrite/ansible-playbook/playbooks/site.yml

# Ansible inventory path
ANSIBLE_INVENTORY_PATH=./k8s-rewrite/ansible-playbook/inventory/production.ini

# Ansible group vars path
ANSIBLE_VARS_PATH=./k8s-rewrite/ansible-playbook/group_vars/all.yml

# SSH config for cluster deployment (optional, for single-node testing)
SSH_CONFIG_PATH=~/.ssh/cardventory_deploy

# NextAuth session secret (generate with: openssl rand -hex 32)
NEXTAUTH_SECRET=your-super-secret-nextauth-key-minimum-32-chars-long

# NextAuth callback URL
NEXTAUTH_URL=http://localhost:3000

# Session cookie settings
NEXTAUTH_COOKIE_NAME=session
NEXTAUTH_COOKIE_OPTIONS_SAMESITE=lax
NEXTAUTH_COOKIE_OPTIONS_SECURE=false

# API rate limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Nonsecret local-development template. Supply key values securely outside Git.
DATABASE_URL=file:./dev.db
BOTRUS_JWT_SECRET=
BOTRUS_SECRETS_KEY=
BORTUS_SECRET_NAMESPACES=default
# Optional operator kubeconfig path; otherwise ~/.kube/config or in-cluster SA.
# KUBECONFIG=
# Metadata-only explicit alias JSON file (see docs/BORTUS-DEPLOYMENT.md).
# BORTUS_SECRET_ALIASES_FILE=
# Local bootstrap credentials are independent of the target cluster.
# ANSIBLE_BECOME_PASSWORD=
# ANSIBLE_PRIVATE_KEY_FILE=
# ANSIBLE_REMOTE_USER=

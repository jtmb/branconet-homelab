// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Variable {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("kubernetes")
  encrypted Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("variables")
}

// Metadata only: values live exclusively in Kubernetes.
model SecretReference {
  alias     String @id
  namespace String
  name      String
  key       String

  @@map("secret_references")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("readonly") // "readonly" | "write"
  sessionVersion Int    @default(0)
  engineAdmin  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("users")
}

// A seeded row acquires SQLite's write lock before account invariant reads.
model AccountLock {
  id     Int @id
  locked Int @default(0)

  @@map("account_lock")
}

// KV tables contain metadata only. Current/history values stay in native Secrets.
model KvMount {
  id         String   @id @default(uuid())
  name       String   @unique
  namespaces String   // JSON array, validated against the operator allowlist
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  paths      KvPath[]
  @@map("kv_mounts")
}

model KvPath {
  id         String   @id @default(uuid())
  mountId    String
  mount      KvMount  @relation(fields: [mountId], references: [id], onDelete: Restrict)
  path       String
  namespace  String
  name       String
  retention  Int      @default(20)
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  fields     KvField[]
  @@unique([mountId, path])
  @@index([namespace, name])
  @@map("kv_paths")
}

model KvField {
  id        String @id @default(uuid())
  pathId    String
  path      KvPath @relation(fields: [pathId], references: [id], onDelete: Restrict)
  field     String
  namespace String
  name      String
  key       String
  @@unique([pathId, field])
  @@unique([namespace, name, key])
  @@map("kv_fields")
}

model KvPolicy {
  id        String   @id @default(uuid())
  principal String   // user:<id>, identity:<id> or legacy-lookup
  mountId   String?  // null means all mounts
  prefix    String   @default("")
  effect    String   // allow or deny
  actions   String   // validated JSON action array
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  @@index([principal])
  @@map("kv_policies")
}

model KvIdentity {
  id                  String   @id @default(uuid())
  ownerId             String
  ownerSessionVersion Int
  name                String
  credentialHash      String   @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime @default(now())
  @@index([ownerId])
  @@map("kv_identities")
}

model KvServicePrincipal {
  id       String  @id
  enabled  Boolean @default(true)
  revision Int     @default(1)
  @@map("kv_service_principals")
}

model KvLegacyGrant {
  id        String @id @default(uuid())
  pathId    String
  alias     String
  namespace String
  name      String
  key       String
  @@unique([pathId, alias])
  @@map("kv_legacy_grants")
}

model KvOperation {
  id              String   @id @default(uuid())
  actorId         String
  pathId          String
  mountId         String
  path            String
  namespace       String
  name            String
  action          String
  previousVersion Int?
  newVersion      Int?
  outcome         String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([pathId, createdAt])
  @@map("kv_operations")
}

model KvAudit {
  id              String   @id @default(uuid())
  actorId         String
  operationId     String?
  action          String
  mountId         String?
  pathId          String?
  path            String?
  namespace       String?
  name            String?
  principal       String?
  alias           String?
  key             String?
  previousVersion Int?
  newVersion      Int?
  outcome         String
  createdAt       DateTime @default(now())
  @@index([pathId, createdAt])
  @@map("kv_audit")
}

model KvRotation {
  id           String   @id @default(uuid())
  pathId       String
  actorId      String
  field        String
  consumerKind String
  consumerNamespace String
  consumerName String
  consumerUid  String?
  consumerResourceVersion String?
  state        String   @default("prepare")
  operationId  String?
  revision     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([pathId])
  @@map("kv_rotations")
}

model Node {
  id        String   @id @default(cuid())
  name      String   @default("")
  hostname  String   @unique
  ipAddress String
  role      String   @default("master") // master, worker
  status    String   @default("pending") // pending, ready, error
  cpu       Int?                          // CPU cores
  memory    Int?                          // Memory in GB
  createdAt DateTime @default(now())

  @@map("nodes")
}

model Job {
  id         String   @id @default(cuid())
  playbook   String
  status     String   @default("running") // running, success, failed
  output     String   @default("")        // Full terminal output
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  @@map("jobs")
}

model ClusterState {
  id          String   @id @default(cuid())
  kubeconfig  String   @default("")      // Encrypted kubeconfig for cluster access
  deployed    Boolean  @default(false)
  deployedAt  DateTime?
  updatedAt   DateTime @updatedAt

  @@map("cluster_state")
}

model Deployment {
  id        String   @id @default(cuid())
  name      String   @unique
  namespace String   @default("default")
  replicas  Int      @default(1)
  image     String
  ports     Json?    // Array of port mappings
  env       Json?    // Environment variables (encrypted)
  volumes   Json?    // Volume mounts
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("deployments")
}

model Pod {
  id        String   @id @default(cuid())
  name      String   @unique
  namespace String
  status    String   @default("Pending") // Pending, Running, Succeeded, Failed
  phase     String?  // ContainerStatus (Running, Terminated)
  reason    String?
  message   String?
  node      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pods")
}

model Service {
  id        String   @id @default(cuid())
  name      String   @unique
  namespace String
  type      String   // ClusterIP, NodePort, LoadBalancer
  port      Int
  targetPort Int?
  protocol  String   @default("TCP")
  createdAt DateTime @default(now())

  @@map("services")
}

model PersistentVolumeClaim {
  id        String   @id @default(cuid())
  name      String   @unique
  namespace String
  status    String   // Pending, Bound, Terminated
  capacity  String?  // e.g., "50Gi"
  accessModes Json?  // ["ReadWriteOnce", etc.]
  createdAt DateTime @default(now())

  @@map("pvc")
}

model Volume {
  id        String   @id @default(cuid())
  name      String   @unique
  namespace String
  status    String   // attached, detached, degraded
  capacity  String?
  size      String?
  createdAt DateTime @default(now())

  @@map("longhorn_volumes")
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("app_settings")
}

model GitRepo {
  id           String   @id @default(cuid())
  name         String   @unique
  url          String
  branch       String   @default("main")
  path         String   @default("./")
  authMethod   String   @default("none")   // none, ssh, https
  authData     String   @default("")       // Encrypted JSON (deploy key or token)
  namespace    String   @default("")       // Target namespace for the Kustomization
  syncInterval String   @default("5m")     // Flux sync interval
  status       String   @default("syncing") // active, syncing, error
  lastSync     DateTime?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("git_repos")
}

  "cases": [
    {
      "id": "A02-deleted-account",
      "source": "src/lib/auth.ts",
      "testFile": "tests/accounts.test.ts",
      "parent": "SQLite account invariants and session revocation across independent clients",
      "children": [
        "exactly one bootstrap claim when registration is closed",
        "open registration still has exactly one initial writer; uniqueness is 409",
        "cross-demotion, cross-deletion and mixed changes preserve a writer",
        "session existence, reset revocation, role recheck and self protection"
      ],
      "before": "const user = await directAccountReader.readSession(payload.sub);",
      "after": "const user = await directAccountReader.readSession(payload.sub) ?? { id: payload.sub, username: payload.username, sessionVersion: payload.sessionVersion };",
      "failures": [
        {
          "name": "session existence, reset revocation, role recheck and self protection",
          "line": 83,
          "witnesses": [
            "expected: ~",
            "username: 'session_writer'"
          ]
        }
      ],
      "mutantSHA256": "5e4a70ec8231b8f0ae8c68bac7387c0b8a4e2c418b6f1517c1c4b6e830387d78"
    },
    {
      "id": "A03-bootstrap-writer",
      "source": "src/lib/account-store.ts",
      "testFile": "tests/account-registration.test.ts",
      "parent": "concurrent distinct and duplicate bootstrap honors all environment/AppSetting permutations",
      "children": [
        "environment false; setting null; distinct",
        "environment false; setting null; duplicate",
        "environment false; setting false; distinct",
        "environment false; setting false; duplicate",
        "environment false; setting true; distinct",
        "environment false; setting true; duplicate",
        "environment true; setting null; distinct",
        "environment true; setting null; duplicate",
        "environment true; setting false; distinct",
        "environment true; setting false; duplicate"
      ],
      "before": "const role = await tx.user.count() === 0 ? \"write\" : \"readonly\";",
      "after": "const role = await tx.user.count() >= 0 ? \"write\" : \"readonly\";",
      "failures": [
        {
          "name": "environment false; setting true; distinct",
          "line": 27,
          "witnesses": [
            "expected: 1",
            "actual: 6"
          ]
        },
        {
          "name": "environment false; setting true; duplicate",
          "line": 38,
          "witnesses": [
            "expected: 'readonly'",
            "actual: 'write'"
          ]
        },
        {
          "name": "environment true; setting null; distinct",
          "line": 27,
          "witnesses": [
            "expected: 1",
            "actual: 6"
          ]
        },
        {
          "name": "environment true; setting null; duplicate",
          "line": 38,
          "witnesses": [
            "expected: 'readonly'",
            "actual: 'write'"
          ]
        },
        {
          "name": "environment true; setting false; distinct",
          "line": 27,
          "witnesses": [
            "expected: 1",
            "actual: 6"
          ]
        },
        {
          "name": "environment true; setting false; duplicate",

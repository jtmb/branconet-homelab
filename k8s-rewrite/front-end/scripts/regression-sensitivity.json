    {
      "id": "A04-name-admission",
      "source": "src/lib/kubectl-client.ts",
      "testFile": "tests/kubectl.test.ts",
      "testName": "resource boundaries reject option and path injection before execution",
      "before": "/^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$/",
      "after": "/^\\S+$/",
      "assertionLine": 28,
      "operator": "throws",
      "witness": "Missing expected exception",
      "mutantSHA256": "6cbadfbdca93976ff80273d548226da4aeadeed12cac72634c2de2da1d0ba055"
    },
    {
      "id": "A05-failed-stdout",
      "source": "src/lib/kubectl-client.ts",
      "testFile": "tests/kubectl.test.ts",
      "testName": "failed subprocess output never becomes a successful mutation or public error",
      "before": "} catch (error) { throw error instanceof KubernetesCommandError ? error : failure(error); }",
      "after": "} catch (error) {\n      const failed = error as { stdout?: unknown } | null;\n      if (typeof failed?.stdout === \"string\") return failed.stdout;\n      throw error instanceof KubernetesCommandError ? error : failure(error);\n    }",
      "assertionLine": 51,
      "operator": "==",
      "witness": "actual instanceof KubernetesCommandError",
      "mutantSHA256": "d815f12e6c1f639472e75202f8cee01c8f33b2be17d2149d5055dcf447c79d58"
    },
    {
      "id": "A06-outage-empty",
      "source": "src/lib/resource-cache.ts",
      "testFile": "tests/resource-cache.test.ts",
      "testName": "failure backoff preserves labelled bounded stale data and never invents empty success",
      "before": "const value = await this.loader(resource);",
      "after": "const value = await this.loader(resource).catch(() => ({ items: [] }));",
      "assertionLine": 28,
      "operator": "strictEqual",
      "witness": "actual: 'empty'",
      "mutantSHA256": "65f5db583e08837873a5c2797bf6be560e7450be766bc1ee7f497726ff52134e"
    },

[Unit]
Description=Off-host BORTUS monitor heartbeat and node02 lease reader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bortus-certificate-watchdog
Group=bortus-certificate-watchdog
StateDirectory=bortus-certificate-watchdog
StateDirectoryMode=0700
WorkingDirectory=/var/lib/bortus-certificate-watchdog
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GOMAXPROCS=1
RuntimeDirectory=bortus-certificate-watchdog-cache
RuntimeDirectoryMode=0700
Environment=HOME=/run/bortus-certificate-watchdog-cache
Environment=XDG_CACHE_HOME=/run/bortus-certificate-watchdog-cache
UnsetEnvironment=KUBECONFIG HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/usr/bin/python3 -B /usr/local/libexec/bortus-certificate-watchdog/run-certificate-watchdog.py --managed-host --config /etc/bortus-certificate-watchdog/enrollment.json --state-dir /var/lib/bortus-certificate-watchdog --loop
Restart=on-failure
RestartSec=30
TimeoutStopSec=35
KillMode=control-group
UMask=0077
MemoryMax=128M
MemorySwapMax=0
CPUQuota=5%
TasksMax=32
LimitCORE=0
LimitFSIZE=20M
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET
InaccessiblePaths=-/etc/kubernetes
ReadOnlyPaths=-/etc/bortus-certificate-watchdog -/run/bortus-certificate-watchdog
IPAddressDeny=any
IPAddressAllow=192.168.0.251
LogRateLimitIntervalSec=60s
LogRateLimitBurst=10

[Install]
WantedBy=multi-user.target

[Unit]
Description=External short-lived observation-only CSR credential refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=bortus-csr-controller
RuntimeDirectory=bortus-csr-controller
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GOMAXPROCS=1
Environment=HOME=/run/bortus-csr-controller
Environment=XDG_CACHE_HOME=/run/bortus-csr-controller/cache
UnsetEnvironment=KUBECONFIG HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/usr/bin/python3 -B /usr/local/libexec/bortus-csr-controller/refresh-csr-controller-credential.py
TimeoutStartSec=210
UMask=0077
MemoryMax=256M
MemorySwapMax=0
CPUQuota=10%
TasksMax=64
LimitCORE=0
LimitFSIZE=2M
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
IPAccounting=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=-/etc/bortus-csr-controller /etc/kubernetes/admin.conf
ReadWritePaths=/run/bortus-csr-controller
IPAddressDeny=any
IPAddressAllow=192.168.0.251
LogRateLimitIntervalSec=60s
LogRateLimitBurst=10
